+def resample_uniform_table(x, energy, force, minval, maxval, periodic=False):
+    """Resample a center-based IBI profile to ESPResSo's uniform table grid."""
+    x = np.asarray(x, dtype=float)
+    energy = np.asarray(energy, dtype=float)
+    force = np.asarray(force, dtype=float)
+
+    if x.ndim != 1 or energy.shape != x.shape or force.shape != x.shape:
+        raise ValueError("x, energy and force must be one-dimensional arrays of equal length")
+    if len(x) < 3 or not np.all(np.diff(x) > 0.0):
+        raise ValueError("The source table must contain at least three increasing points")
+    if not maxval > minval:
+        raise ValueError("maxval must be greater than minval")
+
+    # Histogram edges contain one more value than histogram centers. Keeping
+    # len(x)+1 output points preserves the original bin spacing on the full domain.
+    grid = np.linspace(float(minval), float(maxval), len(x) + 1)
+
+    if periodic:
+        period = float(maxval - minval)
+        x0 = float(x[0])
+        x_ext = np.concatenate((x, [x0 + period]))
+        e_ext = np.concatenate((energy, [energy[0]]))
+        spline = CubicSpline(x_ext, e_ext, bc_type='periodic')
+        query = ((grid - x0) % period) + x0
+        energy_out = spline(query)
+        force_out = -spline(query, 1)
+        # ESPResSo includes both endpoints for a full 0..2*pi torsion table.
+        energy_out[-1] = energy_out[0]
+        force_out[-1] = force_out[0]
+    else:
+        # Use one interpolant for both quantities so force samples are the
+        # derivative of the same energy profile.
+        spline = CubicHermiteSpline(x, energy, -force, extrapolate=True)
+        energy_out = spline(grid)
+        force_out = -spline(grid, 1)
+
+    steps = np.diff(grid)
+    if not np.allclose(steps, steps[0], rtol=1e-12, atol=1e-14):
+        raise RuntimeError("Internal error: output table grid is not uniform")
+    if not (np.all(np.isfinite(energy_out)) and np.all(np.isfinite(force_out))):
+        raise RuntimeError("Non-finite value generated while resampling a table")
+
+    energy_out -= np.min(energy_out)
+    return grid, energy_out, force_out
+
