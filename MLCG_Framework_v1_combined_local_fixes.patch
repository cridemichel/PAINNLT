+def normalize_density(hist, dx, floor=1e-6):
+    """Return a finite, normalized one-dimensional probability density."""
+    density = np.asarray(hist, dtype=float)
+    density = np.nan_to_num(density, nan=0.0, posinf=0.0, neginf=0.0)
+    density = np.clip(density, floor, None)
+    norm = np.sum(density) * dx
+    if not np.isfinite(norm) or norm <= 0.0:
+        raise ValueError("Cannot normalize an empty or non-finite histogram")
+    return density / norm
+
+
+def periodic_derivative(values, dx):
+    """Second-order central derivative on a periodic, uniform grid."""
+    values = np.asarray(values, dtype=float)
+    return (np.roll(values, -1) - np.roll(values, 1)) / (2.0 * dx)
+
+
+def periodic_energy_force(energy, dx, force_max=150.0):
+    """Build a periodic force from one periodic energy array.
+
+    If the requested force cap is exceeded, scale the whole energy profile.
+    Scaling, unlike component-wise clipping, preserves F = -dV/dq and periodicity.
+    """
+    energy = np.asarray(energy, dtype=float).copy()
+    energy -= np.min(energy)
+    force = -periodic_derivative(energy, dx)
+    max_abs_force = float(np.max(np.abs(force))) if force.size else 0.0
+    if force_max is not None and max_abs_force > force_max:
+        scale = force_max / max_abs_force
+        energy *= scale
+        force *= scale
+    return energy, force
+
