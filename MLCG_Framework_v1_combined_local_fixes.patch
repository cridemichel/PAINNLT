+def find_site_specific_priors(priors):
+    key_map = {
+        'bonds': ('site_i', 'site_j'),
+        'angles': ('site_i', 'site_j', 'site_k'),
+        'dihedrals': ('site_i', 'site_j', 'site_k', 'site_l'),
+    }
+    offenders = []
+    for section, keys in key_map.items():
+        for idx, term in enumerate(priors.get(section, [])):
+            if any(int(term.get(key, -1)) != -1 for key in keys):
+                offenders.append(f"{section}[{idx}]")
+    return offenders
+
+
+def assert_current_ibi_runner_is_applicable(priors):
+    offenders = find_site_specific_priors(priors)
